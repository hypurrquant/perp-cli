{
  "name": "perp-cli",
  "version": "0.15.1",
  "description": "Multi-DEX Perpetual Futures CLI - Pacifica, Hyperliquid, Lighter, Aster, Lighter RH, Ondo Perps, Arcus, QFEX, RISEx (read-only), TxFlow (market data, unofficial API)",
  "bin": {
    "perp": "dist/index.js",
    "perp-mcp": "dist/mcp-server.js",
    "perp-guardrail": "dist/guardrail/perp-guardrail.js"
  },
  "exports": {
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "import": "./dist/ws/index.js",
      "default": "./dist/ws/index.js"
    },
    "./ws/node": {
      "types": "./dist/ws/node.d.ts",
      "import": "./dist/ws/node.js",
      "default": "./dist/ws/node.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ws": [
        "dist/ws/index.d.ts"
      ],
      "ws/node": [
        "dist/ws/node.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/mcp-server.js",
    "./dist/guardrail/perp-guardrail.js"
  ],
  "files": [
    "dist",
    "skills",
    "vendor/lighter-signer"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc && tsup --config tsup.ws.config.ts && tsup --config tsup.perp-ws.config.ts",
    "dev": "tsc --watch",
    "test": "vitest run --exclude '**/integration/**'",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:all": "vitest run",
    "test:conformance": "vitest run src/__tests__/conformance",
    "test:conformance:live": "PERP_LIVE=1 vitest run -c vitest.conformance.live.config.ts",
    "conformance:record": "tsx scripts/conformance/record.ts",
    "release-qa": "node scripts/release-qa/run.mjs",
    "e2e": "tsx scripts/e2e/run.ts",
    "e2e:typecheck": "tsc -p scripts/e2e/tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "sync-skill-version": "node scripts/sync-skill-version.mjs",
    "prepublishOnly": "node scripts/sync-skill-version.mjs --check && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build"
  },
  "keywords": [
    "pacifica",
    "hyperliquid",
    "lighter",
    "aster",
    "lighter-rh",
    "robinhood-chain",
    "ondo",
    "ondo-perps",
    "arcus",
    "qfex",
    "risex",
    "rise-chain",
    "txflow",
    "variational",
    "grvt",
    "solana",
    "perps",
    "dex",
    "cli",
    "trading",
    "funding-rate",
    "arbitrage",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "perpetual-futures",
    "defi",
    "ethereum"
  ],
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@msgpack/msgpack": "^3.1.3",
    "@open-wallet-standard/core": "1.3.2",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "ethers": "^6.17.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "react": "^19.2.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.6",
    "ts-morph": "^27.0.2",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "hono@<4.13.7": "^4.13.13",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "fast-uri@<3.1.8": "^3.1.8",
      "proxy-addr@<2.0.8": "^2.0.8",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.2",
      "ip-address@<=10.7.0": "^10.7.4",
      "qs@<6.16.0": "^6.16.0",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "ws@>=7.0.0 <7.5.11": "^7.5.13",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1"
    }
  }
}
